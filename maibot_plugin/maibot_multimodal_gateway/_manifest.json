{
  "manifest_version": 2,
  "id": "ayakanya.multimodal-gateway",
  "version": "0.1.1",
  "name": "MaiBot Multimodal Gateway",
  "description": "本機訂閱 Gateway：Grok／ChatGPT／Gemini 文字、生圖與 Grok 影片；僅限 Mai Chat 測試平台。",
  "author": {
    "name": "AyakaNya",
    "url": "https://github.com/AyakaNya"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/AyakaNya/maibot-multimodal-gateway",
    "documentation": "https://github.com/AyakaNya/maibot-multimodal-gateway/blob/main/docs/MAIBOT.md"
  },
  "host_application": {
    "min_version": "1.3.18",
    "max_version": "1.3.99"
  },
  "sdk": {
    "min_version": "2.20.0",
    "max_version": "2.21.99"
  },
  "dependencies": [],
  "capabilities": [
    "send.text",
    "send.image",
    "files.list",
    "files.upload",
    "files.send"
  ],
  "llm_providers": [
    {
      "client_type": "ayakanya.multimodal_gateway",
      "name": "Local Subscription Gateway",
      "description": "僅純文字 response；不支援工具呼叫、向量或語音。",
      "version": "0.1.0"
    }
  ],
  "i18n": {
    "default_locale": "zh-TW"
  }
}
