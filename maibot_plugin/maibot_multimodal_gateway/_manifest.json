{
  "manifest_version": 2,
  "id": "ayakanya.multimodal-gateway",
  "version": "0.2.0",
  "name": "MaiBot Multimodal Gateway",
  "description": "本機訂閱 Gateway：Grok 工具呼叫橋接／圖片理解、三家文字與生圖、Grok 影片；語音檔尚無訂閱入口。",
  "author": {
    "name": "AyakaNya",
    "url": "https://github.com/AyakaNya"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/AyakaNya/maibot-multimodal-gateway",
    "documentation": "https://github.com/AyakaNya/maibot-multimodal-gateway/blob/main/docs/MAIBOT.md"
  },
  "host_application": {
    "min_version": "1.3.18",
    "max_version": "1.3.99"
  },
  "sdk": {
    "min_version": "2.20.0",
    "max_version": "2.21.99"
  },
  "dependencies": [],
  "capabilities": [
    "send.text",
    "send.image",
    "files.list",
    "files.upload",
    "files.send"
  ],
  "llm_providers": [
    {
      "client_type": "ayakanya.multimodal_gateway",
      "name": "Local Subscription Gateway",
      "description": "Grok 支援文字、JSON 工具橋接、圖片輸入；其他路由仍為純文字。語音檔與向量明確拒絕。",
      "version": "0.2.0"
    }
  ],
  "i18n": {
    "default_locale": "zh-TW"
  }
}
